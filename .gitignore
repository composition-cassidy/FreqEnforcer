*.mp3
*.flac
*.ogg
*.sfk

# Keep curated examples
!spartan_tuner/test/*.wav

# Re-ignore specific test outputs
spartan_tuner/test/3_D4_*.wav
spartan_tuner/test/3_VOVIOUS.wav

# But keep your app images
!spartan_tuner/ICON.png
!spartan_tuner/LOGO.png

# Keep fonts
!spartan_tuner/fonts/**
